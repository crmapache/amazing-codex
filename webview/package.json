{
  "name": "amazing-codex-webview",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && pnpm lint && vite build && ! grep -rqil harness dist",
    "test": "pnpm lint && vitest run",
    "lint": "oxlint --deny-warnings src",
    "preview": "vite preview",
    "build:mobile": "tsc --noEmit && pnpm lint && vite build -c vite.mobile.config.ts && ! grep -rqil 'harness\\|__fixtures__' dist-mobile"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "katex": "0.18.5",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smooth-stream-text": "0.1.2"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "marked": "^18.0.10",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
