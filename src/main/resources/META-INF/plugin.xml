<!-- id, name, version, vendor and description are patched in from build.gradle.kts, so that they have
     one source of truth. Only what Gradle does not set lives here. -->
<!-- require-restart: this plugin cannot be updated on a running IDE, and not only because of the
     "didn't unload fully" complaint the platform shows when one tries. The panel serves its interface
     to the embedded browser through a scheme handler registered in the browser's engine for the whole
     IDE process (see WebviewResources): there is nothing to undo that registration with - JCEF has no
     targeted revocation, and a blanket one would take other plugins' handlers down with it. So after a
     live swap the previous version's handler stays in memory, and the new one would show the old
     interface over new code - the very "functionality issues" from the warning, only real this time.
     Live conversations with their processes do not survive such a swap anyway, so asking for a restart
     is not a loss but an honest way to update. -->
<idea-plugin require-restart="true">
    <depends>com.intellij.modules.platform</depends>
    <!-- The embedded browser, and required on purpose - without it there is no panel at all. Since
         2026.2 it is a bundled plugin, and its classes reach us only through this line.
         Android Studio is the reason it must stay required rather than become optional: it ships the
         Java side of the browser and no native side whatsoever, so the panel there came up as its own
         "this IDE has no browser" notice with nothing a person could do about it. JetBrains publish the
         browser as an ordinary marketplace plugin, natives included, and a required dependency is what
         turns that dead panel into the IDE offering to install it alongside us. Optional would install
         cleanly and then do nothing, which is the worse of the two.
         Whether the browser actually came up is still asked separately (see WebviewHost.isSupported) -
         a dependency that resolved is not a browser that started. -->
    <depends>com.intellij.modules.jcef</depends>
    <!-- Signing in to Codex opens a browser and waits for a code to come back, that is, it is a
         dialogue with a process. We hold it in the built-in terminal rather than invent a sign-in
         screen of our own. -->
    <depends>org.jetbrains.plugins.terminal</depends>
    <!-- A file dropped into the panel from the commit window arrives as a version control object rather
         than a path - there is nothing to parse it with without that module's classes (see
         WebviewFileDrop). The module is built into every JetBrains IDE. -->
    <depends>com.intellij.modules.vcs</depends>

    <resource-bundle>messages.AccBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Where the panel says something to the IDE rather than to the person in front of it: a picture
             of the statistics written into the downloads folder, for instance.
             The id stays the old name on purpose - it is the key the IDE files a person's notification
             settings under, and renaming it would silently reset them. What they read is the caption,
             which comes from the bundle. -->
        <notificationGroup id="Amazing Codex"
                           displayType="BALLOON"
                           bundle="messages.AccBundle"
                           key="notification.group"/>

        <!-- anchor sets the default position only: from then on the user drags the button between the
             edges themselves, and the platform remembers their choice. -->
        <toolWindow
                id="AmazingCodex"
                anchor="right"
                icon="/icons/toolWindow.svg"
                factoryClass="io.github.crmapache.amazingcodex.toolwindow.CodexToolWindowFactory"/>

        <postStartupActivity
                implementation="io.github.crmapache.amazingcodex.startup.AutoOpenPanelActivity"/>

        <!-- Tells the remote agent a project has opened. With remote access off - the default, and how
             it stays unless the user turns it on - this returns immediately and opens nothing. -->
        <postStartupActivity
                implementation="io.github.crmapache.amazingcodex.startup.RemoteAccessActivity"/>
    </extensions>

    <actions>
        <action id="AmazingCodex.SendSelection"
                class="io.github.crmapache.amazingcodex.editor.SendSelectionAction"
                text="Send to Amazing Codex GUI"
                description="Put a reference to the selected lines into the Codex panel input">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <!-- The id keeps its old name although the action now serves the project tree too: a person's
             keymap is filed under it. -->
        <action id="AmazingCodex.SendSelectionAbsolute"
                class="io.github.crmapache.amazingcodex.editor.SendAbsolutePathAction"
                text="Send Absolute Path to Amazing Codex GUI"
                description="Put the full path of the selected files and folders into the Codex panel input">
            <!-- In the project tree it is our only item, and a whole file is all there is to send from
                 there - "Absolute Path" would only make one look for a second item that is not there. -->
            <override-text place="ProjectViewPopup" text="Send to Amazing Codex GUI"/>
            <override-text place="ChangesViewPopup" text="Send to Amazing Codex GUI"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="AmazingCodex.SendSelection"/>
            <!-- The changed files in the Commit tool window, under its own "Copy Path/Reference...". -->
            <add-to-group group-id="ChangesViewPopupMenu" anchor="after" relative-to-action="CopyReferencePopupGroup"/>
            <!-- The project tree's menu, right under "Copy Path/Reference...": a path is what that item is
                 about too. It lives in the shared clipboard group, which also stands in the main Edit menu,
                 the structure view, the console and the navigation bar - there the action hides itself
                 (see SendAbsolutePathAction.offeredIn). -->
            <add-to-group group-id="CutCopyPasteGroup" anchor="after" relative-to-action="CopyReferencePopupGroup"/>
        </action>

        <!-- The panel's own keys (see PanelKeys). In no menu: they live in Settings | Keymap under the
             plugin, and in Find Action. Each works only while the focus is in the panel - everywhere else
             the same key stays with whatever owns it. The ids are filed in people's keymaps once rebound:
             do not rename them. -->
        <!-- The tab keys are the IDE's own, by reference: the keys that move between and close editor tabs
             in this person's keymap do it to the panel's tabs, and follow when the keymap changes. -->
        <action id="AmazingCodex.NextTab"
                class="io.github.crmapache.amazingcodex.toolwindow.NextTabAction"
                text="Amazing Codex GUI: Next Tab"
                description="Show the next tab of the Codex panel"
                use-shortcut-of="NextTab"/>
        <action id="AmazingCodex.PreviousTab"
                class="io.github.crmapache.amazingcodex.toolwindow.PreviousTabAction"
                text="Amazing Codex GUI: Previous Tab"
                description="Show the previous tab of the Codex panel"
                use-shortcut-of="PreviousTab"/>
        <action id="AmazingCodex.CloseTab"
                class="io.github.crmapache.amazingcodex.toolwindow.CloseTabAction"
                text="Amazing Codex GUI: Close Tab"
                description="Close the tab the Codex panel shows"
                use-shortcut-of="CloseContent"/>
        <!-- A new tab and the closed one back: the browser's pair, Ctrl+T and Ctrl+Shift+T (Cmd on a Mac).
             Ctrl+T is Update Project and Ctrl+Shift+T Go to Test in the editor, and stay so there: these are
             disabled outside the panel. -->
        <action id="AmazingCodex.NewTab"
                class="io.github.crmapache.amazingcodex.toolwindow.NewTabAction"
                text="Amazing Codex GUI: New Tab"
                description="Start a new conversation in the Codex panel">
            <keyboard-shortcut first-keystroke="control T" keymap="$default"/>
            <keyboard-shortcut first-keystroke="meta T" keymap="Mac OS X" replace-all="true"/>
            <keyboard-shortcut first-keystroke="meta T" keymap="Mac OS X 10.5+" replace-all="true"/>
        </action>
        <action id="AmazingCodex.ReopenTab"
                class="io.github.crmapache.amazingcodex.toolwindow.ReopenTabAction"
                text="Amazing Codex GUI: Reopen Closed Tab"
                description="Open again the tab of the Codex panel closed last">
            <keyboard-shortcut first-keystroke="control shift T" keymap="$default"/>
            <keyboard-shortcut first-keystroke="meta shift T" keymap="Mac OS X" replace-all="true"/>
            <keyboard-shortcut first-keystroke="meta shift T" keymap="Mac OS X 10.5+" replace-all="true"/>
        </action>
        <!-- Alt+Enter beside Enter: Enter sends into the running turn, this waits for it to finish. In the
             editor Alt+Enter stays the intentions' - the action is disabled there. -->
        <action id="AmazingCodex.QueueMessage"
                class="io.github.crmapache.amazingcodex.toolwindow.QueueMessageAction"
                text="Amazing Codex GUI: Queue Message"
                description="Send the message after the agent finishes its current work">
            <keyboard-shortcut first-keystroke="alt ENTER" keymap="$default"/>
        </action>
    </actions>
</idea-plugin>
